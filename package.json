{
	"name": "tagtape",
	"version": "2.0.0",
	"private": true,
	"license": "MIT",
	"type": "module",
	"packageManager": "pnpm@12.4.1",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"dev": "pnpm --recursive --parallel run dev",
		"build": "pnpm --recursive run build",
		"typecheck": "pnpm --recursive run typecheck",
		"test": "pnpm --recursive --if-present run test",
		"check": "biome check",
		"fix": "biome check --write",
		"docker": "docker build -t tagtape:local . && docker run --rm -p 127.0.0.1:${PORT:-3000}:3000 tagtape:local",
		"docker:dev": "docker compose -f compose.dev.yaml up --build",
		"docker:test": "docker compose -f compose.dev.yaml run --rm --build test sh -c 'pnpm install --frozen-lockfile && pnpm check && pnpm typecheck && pnpm test'",
		"docker:down": "docker compose -f compose.dev.yaml down"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.5",
		"@tanstack/intent": "^0.5.6",
		"@types/node": "catalog:",
		"typescript": "catalog:"
	},
	"intent": {
		"exclude": [
			"@tanstack/react-router#lifecycle/*",
			"@tanstack/react-start#lifecycle/*",
			"@tanstack/react-start#react-start/server-components",
			"@tanstack/react-router#compositions/router-query",
			"@tanstack/router-core#router-core/auth-and-guards",
			"@tanstack/start-client-core#start-core/auth-server-primitives",
			"@tanstack/virtual-file-routes#*"
		]
	}
}
