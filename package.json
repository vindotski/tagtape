{
	"name": "tagtape",
	"private": true,
	"license": "Unlicense",
	"type": "module",
	"packageManager": "pnpm@12.4.1",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"dev": "pnpm --recursive --parallel run dev",
		"build": "pnpm --recursive run build",
		"typecheck": "pnpm --recursive run typecheck",
		"test": "pnpm --recursive --if-present run test",
		"check": "biome check",
		"fix": "biome check --write"
	},
	"devDependencies": {
		"@biomejs/biome": "2.4.5",
		"@tanstack/intent": "^0.5.6",
		"typescript": "catalog:"
	},
	"intent": {
		"exclude": [
			"@tanstack/react-router#lifecycle/*",
			"@tanstack/react-start#lifecycle/*",
			"@tanstack/react-start#react-start/server-components",
			"@tanstack/react-router#compositions/router-query",
			"@tanstack/router-core#router-core/auth-and-guards",
			"@tanstack/start-client-core#start-core/auth-server-primitives",
			"@tanstack/virtual-file-routes#*"
		]
	}
}
