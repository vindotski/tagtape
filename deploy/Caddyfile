# Caddy gets and renews the HTTPS certificate for TAGTAPE_DOMAIN automatically
# (Let's Encrypt; no account email needed).

{
	servers {
		# Slow or stalled clients can't hold connections open: headers must
		# arrive within 10 s and a request body within 30 s. No write timeout:
		# a ZIP download streams for as long as the album takes to convert.
		timeouts {
			read_header 10s
			read_body 30s
			idle 2m
		}
	}
}

{$TAGTAPE_DOMAIN} {
	encode zstd gzip

	# Nothing TagTape accepts is bigger than a few KB (album details, links).
	request_body {
		max_size 64KB
	}

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		# Never shown inside another site's frame (clickjacking); the app's CSP
		# says the same with frame-ancestors. The CSP itself comes from the app,
		# because it carries a fresh nonce per page.
		X-Frame-Options "DENY"
		Cross-Origin-Opener-Policy "same-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
		-Server
	}

	# ZIP downloads stream straight through (Caddy doesn't buffer responses).
	reverse_proxy app:3000
}

www.{$TAGTAPE_DOMAIN} {
	redir https://{$TAGTAPE_DOMAIN}{uri} permanent
}
