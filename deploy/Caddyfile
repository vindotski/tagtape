# Caddy gets and renews the HTTPS certificate for TAGTAPE_DOMAIN automatically
# (Let's Encrypt; no account email needed).

{$TAGTAPE_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		-Server
	}

	# ZIP downloads stream straight through (Caddy doesn't buffer responses).
	reverse_proxy app:3000
}

www.{$TAGTAPE_DOMAIN} {
	redir https://{$TAGTAPE_DOMAIN}{uri} permanent
}
