# Copy to /opt/tagtape/.env on the server. The deploy workflow only changes
# TAGTAPE_TAG; everything else is yours.

# Public hostname. DNS A/AAAA records for it and for www.<it> must point at the server.
TAGTAPE_DOMAIN=tagtape.app

# Image tag to run: a release (2.0.0) or an immutable sha-abc1234 to pin/roll back.
TAGTAPE_TAG=2.0.0

# Optional API tuning (defaults shown)
# LOG_LEVEL=info
# JOB_TTL_MIN=30
# MAX_ACTIVE_JOBS=2
# MAX_QUEUED_JOBS=20
# TRACK_CONCURRENCY=2
