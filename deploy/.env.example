# Copy to /opt/tagtape/.env on the server. The deploy workflow only changes
# TAGTAPE_TAG; everything else is yours.

# Public hostname. DNS A/AAAA records for it and for www.<it> must point at the server.
TAGTAPE_DOMAIN=tagtape.app

# Image tag to run: a release (2.0.0) or an immutable sha-abc1234 to pin/roll back.
TAGTAPE_TAG=2.0.0

# Optional API tuning (defaults shown)
# LOG_LEVEL=info
# JOB_TTL_MIN=30
# MAX_ACTIVE_PROBES=4
# MAX_QUEUED_JOBS=20
# MAX_ACTIVE_STREAMS=2
# MAX_QUEUED_STREAMS=10
# TRACK_CONCURRENCY=2
# MAX_DIRECT_MB=300
# MAX_DOWNLOADS_PER_JOB=5
# MAX_STORED_JOBS=500
# CHECK_TIMEOUT_SEC=180
# MAX_JOBS_PER_CLIENT_HOUR=30
# MAX_CHECKING_JOBS_PER_CLIENT=2
# MAX_DOWNLOADS_PER_CLIENT=2
# Proof-of-work difficulty for starting an album (PBKDF2 iterations per try)
# POW_COST=2000
