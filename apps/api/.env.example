# Copy to .env for local development (`pnpm --filter @tagtape/api dev` loads it).
# Generate a token with: openssl rand -hex 32
API_TOKEN=

# Optional (defaults shown)
# PORT=4000
# HOST=127.0.0.1
# LOG_LEVEL=info
# JOB_TTL_MIN=30
# MAX_ACTIVE_PROBES=4
# MAX_QUEUED_JOBS=20
# MAX_ACTIVE_STREAMS=2
# MAX_QUEUED_STREAMS=10
# TRACK_CONCURRENCY=2
# YTDLP_TIMEOUT_SEC=1800
# YTDLP_BIN=yt-dlp
# YTDLP_JS_RUNTIME=node
# FFMPEG_BIN=ffmpeg
