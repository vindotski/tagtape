# Copy to .env for local development (`pnpm --filter @tagtape/api dev` loads it).
# Generate a token with: openssl rand -hex 32
API_TOKEN=

# Source plugins to load: comma-separated paths to their modules (relative
# paths resolve against apps/api). Direct MP3 links work without any.
# TAGTAPE_PLUGINS=

# Optional (defaults shown)
# PORT=4000
# HOST=127.0.0.1
# LOG_LEVEL=info
# JOB_TTL_MIN=30
# MAX_ACTIVE_PROBES=4
# MAX_QUEUED_JOBS=20
# MAX_ACTIVE_STREAMS=2
# MAX_QUEUED_STREAMS=10
# TRACK_CONCURRENCY=2
# MAX_DIRECT_MB=300
# MAX_DOWNLOADS_PER_JOB=5
# MAX_STORED_JOBS=500
# CHECK_TIMEOUT_SEC=180
# MAX_JOBS_PER_CLIENT_HOUR=30
# MAX_CHECKING_JOBS_PER_CLIENT=2
# MAX_DOWNLOADS_PER_CLIENT=2
# FFMPEG_BIN=ffmpeg
