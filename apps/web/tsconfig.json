{
	"extends": "../../tsconfig.base.json",
	"include": ["**/*.ts", "**/*.tsx"],
	"exclude": ["node_modules", "dist"],
	"compilerOptions": {
		"jsx": "react-jsx",
		"lib": ["ES2022", "DOM", "DOM.Iterable"],
		"types": ["vite/client"],
		"allowImportingTsExtensions": true,
		"paths": {
			"#/*": ["./src/*"],
			"@/*": ["./src/*"]
		}
	}
}
