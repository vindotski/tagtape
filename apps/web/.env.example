# Copy to .env for local development. Server-only: read by server functions
# via process.env, never sent to the browser (no VITE_ prefix on purpose).
# In the Docker image these are set automatically by docker/start.mjs.

# Where the web server reaches the API.
API_URL=http://127.0.0.1:4000
# Same value as the API's API_TOKEN.
API_TOKEN=

# Guest accounts (Spotcraft's backend kit). On Spotcraft, DATABASE_URL is set
# for you when the app has a database; set AUTH_SECRET (`openssl rand -hex 32`)
# and PUBLIC_URL in the dashboard. Locally, `pnpm docker:dev` sets all three.
DATABASE_URL=
# At least 32 characters. Changing it signs every guest out.
AUTH_SECRET=
# The app's address: https, or http on localhost.
PUBLIC_URL=http://localhost:3000
