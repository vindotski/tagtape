# Copy to .env. Server-only: read by server functions via process.env, never
# sent to the browser (no VITE_ prefix on purpose).

# Where the web server reaches the API.
API_URL=http://127.0.0.1:4000
# Same value as the API's API_TOKEN.
API_TOKEN=
# Where browsers download ZIPs from. Defaults to API_URL; set it when the API's
# public address differs from the private one (e.g. https://api.tagtape.app).
# PUBLIC_API_URL=http://127.0.0.1:4000
