{
	"name": "@tagtape/desktop",
	"private": true,
	"description": "Turns track links plus album details into a folder of ID3-tagged MP3s.",
	"author": "TagTape <noreply@tagtape.app>",
	"homepage": "https://tagtape.app",
	"license": "Unlicense",
	"type": "module",
	"main": "./out/main/index.js",
	"imports": {
		"#/*": "./src/renderer/*"
	},
	"scripts": {
		"dev": "electron-vite dev",
		"build": "electron-vite build",
		"start": "electron-vite preview",
		"typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
		"test": "vitest run",
		"package": "electron-vite build && electron-builder --config electron-builder.config.mjs --publish never"
	},
	"dependencies": {
		"sharp": "^0.35.5"
	},
	"optionalDependencies": {
		"@img/sharp-darwin-arm64": "0.35.5",
		"@img/sharp-darwin-x64": "0.35.5",
		"@img/sharp-libvips-darwin-arm64": "1.3.4",
		"@img/sharp-libvips-darwin-x64": "1.3.4",
		"@img/sharp-libvips-linux-x64": "1.3.4",
		"@img/sharp-linux-x64": "0.35.5",
		"@img/sharp-win32-x64": "0.35.5"
	},
	"devDependencies": {
		"@dnd-kit/core": "^6.3.1",
		"@dnd-kit/sortable": "^10.0.0",
		"@dnd-kit/utilities": "^3.2.2",
		"@fontsource-variable/oxanium": "^5.3.0",
		"@tagtape/shared": "workspace:*",
		"@tailwindcss/vite": "^4.3.4",
		"@tanstack/react-router": "1.170.46",
		"@tanstack/router-plugin": "^1.169.0",
		"@types/node": "catalog:",
		"@types/react": "^19.2.0",
		"@types/react-dom": "^19.2.0",
		"@vitejs/plugin-react": "^6.0.1",
		"class-variance-authority": "^0.7.1",
		"cn": "^0.5.2",
		"electron": "^45.0.0",
		"electron-builder": "^26.18.0",
		"electron-vite": "^6.0.0",
		"lucide-react": "^1.69.0",
		"node-id3": "^0.2.9",
		"react": "^19.2.0",
		"react-aria-components": "^1.22.1",
		"react-dom": "^19.2.0",
		"shadcn": "^4.23.0",
		"tailwindcss": "^4.3.4",
		"tw-animate-css": "^1.4.0",
		"typescript": "catalog:",
		"vite": "^8.0.0",
		"vitest": "catalog:",
		"zod": "catalog:"
	}
}
