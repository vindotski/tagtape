---
import Page from "../layouts/Page.astro";

const base = import.meta.env.BASE_URL.replace(/\/$/, "");
---

<Page title="Page not found · TagTape" description="This page doesn't exist on the TagTape website." noindex>
	<section class="max-w-2xl py-8 lg:py-14">
		<h1 class="text-3xl font-bold tracking-tight sm:text-4xl">This page doesn't exist</h1>
		<p class="mt-4 text-muted-foreground">
			The link may be old or mistyped. If someone shared an album with you, the link should contain
			<code>/open/#a=</code> followed by a long run of letters and numbers; ask them for it again.
		</p>
		<p class="mt-6">
			<a href={`${base}/`} class="border bg-card px-4 py-2.5 font-medium hover:bg-muted">Go to TagTape</a>
		</p>
	</section>
</Page>
