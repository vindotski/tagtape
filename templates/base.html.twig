<!DOCTYPE html>
<html>
    <head>
        <meta charset="UTF-8">
        <meta http-equiv="X-UA-Compatible" content="IE=edge">
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{% block title %}Welcome!{% endblock %}</title>
        {% block stylesheets %}
        <link rel="stylesheet" href="/css/main.css">
        {% endblock %}
        {% if app.request.pathinfo != '/javascript-disabled' %}
        <noscript>
            <meta http-equiv="Refresh" content="0;{{ path('nojs') }}">
        </noscript>
        {% endif %}
    </head>

    <body class="{% if app.request.pathinfo == '/javascript-disabled' %}no-js-page{% endif %}">
        {% block body %}{% endblock %}

        {% if app.request.pathinfo != '/javascript-disabled' %}
            {% block javascripts %}
            <script src="https://cdnjs.cloudflare.com/ajax/libs/Sortable/1.10.1/Sortable.min.js"></script>
            <script src="/js/main.js"></script>
            {% endblock %}
        {% endif %}
    </body>
</html>
