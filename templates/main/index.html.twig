{% extends 'base.html.twig' %}

{% block title %}Albumie - YouTube To MP3 with Metadata, YouTube Downloader
{% endblock %}

{% block body %}
	<header class="header">
		<div class="container">
			<h1>Albumie</h1>
			<p>
				Download YouTube videos to mp3 files and automatically apply the metadata
				to have organized music on any device that has standard MP3 player.
			</p>
			<a href="https://ivanvinski.com" class="button button-outline button-outline-white" target="_blank" rel="nofollow">Ivan Vinski App</a>
		</div>
	</header>

	<main id="albumie-form-wrapper" class="container">
		{{ include('form/_albumie.html.twig') }}
	</main>

	<div id="app-loader" class="loader">
		<i class="loader-icon fas fa-spinner"></i>
		Loading Albumie...
	</div>
{% endblock %}
