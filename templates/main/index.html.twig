{% extends 'base.html.twig' %}

{% block title %}Albumie - YouTube To MP3 with Metadata, YouTube Downloader
{% endblock %}

{% block body %}
	<header class="header">
		<div class="container">
			<h1>Albumie</h1>
			<p>
				Download YouTube videos to mp3 files and automatically apply the metadata
				to have organized music on any device that has standard MP3 player.
			</p>
		</div>
	</header>

	<main id="albumie-form-wrapper" class="container">
		{{ include('form/_albumie.html.twig') }}
	</main>

	<footer class="footer">
		<div class="container">
			<ul class="link-list">
				<li class="link-list-item">
					<a href="https://ivanvinski.com" target="_blank" class="button button-outline" target="_blank">
						<i class="fas fa-globe"></i>
						Ivan Vinski App
					</a>
				</li>
				<li class="link-list-item">
					<a href="https://github.com/ivanvinski/albumie" target="_blank" class="button button-outline" target="_blank">
						<i class="fas fa-code"></i>
						Fork me on GitHub
					</a>
				</li>
			</ul>
		</div>
	</footer>

	<div id="app-loader" class="loader">
		<i class="loader-icon fas fa-spinner"></i>
		Loading Albumie...
	</div>

	<iframe></iframe>
{% endblock %}
