{% extends 'base.html.twig' %}

{% block title %}JavaScript is disabled - Albumie
{% endblock %}

{% block body %}
	<article class="notification is-warning">
		<h1 class="title">JavaScript is disabled</h1>
		<p>
			<strong>Albumie</strong>
			needs JavaScript enabled to run safely and effectively.
		</p>
		<br>
		<p>
			Please <strong>enable JavaScript</strong> and click the
      button below to use <strong>Albumie</strong>.
		</p>
    <br>
    <a href="{{ path('home') }}" class="button">Try again</a>
	</article>
{% endblock %}
