{% use "form_div_layout.html.twig" %}

{% block form_widget_simple -%}
		{% set attr = label_attr|merge({class: ('input ' ~ label_attr.class|default(''))|trim}) %}
    {% if errors|length > 0 -%}
        {% set attr = attr|merge({class: (attr.class|default('') ~ ' is-danger')|trim}) %}
    {% endif %}
    {{- parent() -}}
{%- endblock form_widget_simple %}

{% block form_label -%}
		{% set label_attr = label_attr|merge({class: ('label ' ~ label_attr.class|default(''))|trim}) %}
    {% if errors|length > 0 -%}
        {% set label_attr = label_attr|merge({class: (label_attr.class|default('') ~ ' error')|trim}) %}
    {% endif %}
    {{- parent() -}}
{%- endblock form_label %}

{% block form_row -%}
    {%- set widget_attr = {} -%}
    {%- if help is not empty -%}
        {%- set widget_attr = {attr: {'aria-describedby': id ~"_help"}} -%}
    {%- endif -%}
    <div{% with {attr: row_attr|merge({class: ('field ' ~ row_attr.class|default(''))|trim})} %}{{ block('attributes') }}{% endwith %}>
				{{- form_label(form) -}}
				{{- form_widget(form, widget_attr) -}}
				{{- form_help(form) -}}
				{{- form_errors(form) -}}
    </div>
{%- endblock form_row %}
