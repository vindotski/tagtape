{
	"extends": "../tsconfig.base.json",
	// The main process, the preload script and the pipeline: Node code.
	"include": [
		"src/main",
		"src/preload",
		"src/core",
		"src/ipc.ts",
		"src/env.d.ts",
		"electron.vite.config.ts",
		"vitest.config.ts"
	],
	"compilerOptions": {
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"lib": ["ES2022"],
		"types": ["node"],
		"allowImportingTsExtensions": true,
		"erasableSyntaxOnly": true,
		"esModuleInterop": true,
		"resolveJsonModule": true
	}
}
