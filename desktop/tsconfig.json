{
	"extends": "../tsconfig.base.json",
	// src/renderer (the UI from the old web app) is parked: it joins the
	// typecheck when the Electron shell wires it up.
	"include": ["src/core"],
	"compilerOptions": {
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"lib": ["ES2022"],
		"types": ["node"],
		"allowImportingTsExtensions": true,
		"erasableSyntaxOnly": true,
		"esModuleInterop": true,
		"resolveJsonModule": true
	}
}
